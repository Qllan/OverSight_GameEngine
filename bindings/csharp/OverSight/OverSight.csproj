<Project Sdk="Microsoft.NET.Sdk">
  <!-- OverSight 2D for C#: P/Invoke over the Rust-built oversight library.
       Build the library first (cargo build -release -p oversight); it is
       copied next to your game from OverSightLibDir. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OverSight</RootNamespace>
    <!-- Not OverSight.dll: on Windows that name would collide with the
         native oversight.dll in the same folder -->
    <AssemblyName>OverSight.Net</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OverSightLibDir Condition="'$(OverSightLibDir)' == ''">$(MSBuildThisFileDirectory)../../../target/release/</OverSightLibDir>
  </PropertyGroup>
  <!-- NuGet package (dotnet pack; crates/oversight/sdk/package.py does it
       for the SDK): the binding plus the native library under runtimes/,
       which .NET loads on its own -->
  <PropertyGroup>
    <PackageId>OverSight.Net</PackageId>
    <Version>0.1.0</Version>
    <Authors>OverSight</Authors>
    <Description>OverSight 2D: a 2D game engine for C#, with the native library inside.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>gamedev;2d;engine</PackageTags>
    <RepositoryUrl>https://github.com/Qllan/OverSight_GameEngine</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OverSightLibDir)oversight.dll" Condition="Exists('$(OverSightLibDir)oversight.dll')" CopyToOutputDirectory="PreserveNewest" Link="oversight.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(OverSightLibDir)liboversight.so" Condition="Exists('$(OverSightLibDir)liboversight.so')" CopyToOutputDirectory="PreserveNewest" Link="liboversight.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(OverSightLibDir)liboversight.dylib" Condition="Exists('$(OverSightLibDir)liboversight.dylib')" CopyToOutputDirectory="PreserveNewest" Link="liboversight.dylib" Pack="true" PackagePath="runtimes/osx/native/" />
  </ItemGroup>
</Project>
