     "parameters": {"name": "affection", "expression": "affection + 3"}},
    {"id": "rude", "type": "SetVariable", "position": [1180, 280],
     "parameters": {"name": "affection", "expression": "affection - 1"}},
    {"id": "check", "type": "If", "position": [1450, 160],
     "parameters": {"condition": "affection >= 3 and player != ''"}},
    {"id": "smile", "type": "ShowText", "position": [1700, 60],
     "parameters": {"text": "She smiles. (affection: {affection})", "speaker": "Mia"}},
    {"id": "frown", "type": "ShowText", "position": [1700, 280],
     "parameters": {"text": "She frowns.", "speaker": "Mia"}},
