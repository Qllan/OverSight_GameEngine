    {"from": "answer", "to": "kind", "port": 0},
    {"from": "answer", "to": "rude", "port": 1},
    {"from": "kind", "to": "check"},
    {"from": "rude", "to": "check"},
    {"from": "check", "to": "smile", "port": 0},
    {"from": "check", "to": "frown", "port": 1},
