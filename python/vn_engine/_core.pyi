"""Type stubs for the vn_engine._core Rust extension."""

from typing import Any, Callable, Optional

# --- core ---------------------------------------------------------------

class EventBus:
    def __init__(self) -> None: ...
    def subscribe(self, event_type: str, callback: Callable[..., Any]) -> None:
        """Callbacks get (payload_json); with event_type "*" they get (event_type, payload_json)."""
    def publish(self, event_type: str, payload: str) -> None: ...
    def clear(self) -> None: ...
    def subscriber_count(self, event_type: str) -> int: ...

class ParameterDefinition:
    """param_type: string, text, expression, number, float, int, bool,
    array, object, any, or asset[:kind]. default=None makes it required."""
    name: str
    param_type: str
    default: Any
    def __init__(self, name: str, param_type: str, default: Any = None) -> None: ...
    def is_required(self) -> bool: ...

class BlockDefinition:
    block_type: str
    display_name: str
    inputs: list[str]
    outputs: list[str]
    parameters: list[ParameterDefinition]
    wait: Optional[str]
    def __init__(
        self,
        block_type: str,
        display_name: str,
        inputs: list[str],
        outputs: list[str],
        parameters: list[ParameterDefinition],
        wait: Optional[str] = None,
    ) -> None: ...

class PluginInfo:
    name: str
    version: str
    author: str
    def __init__(self, name: str, version: str, author: str) -> None: ...

class PluginRegistry:
    def __init__(self, with_defaults: bool = False) -> None: ...
    def has_plugin(self, plugin_name: str) -> bool: ...
    def register_plugin(self, info: PluginInfo) -> None: ...
    def register_block(self, plugin_name: str, block: BlockDefinition) -> None: ...
    def get_block(self, block_type: str) -> Optional[BlockDefinition]: ...
    def has_block(self, block_type: str) -> bool: ...
    def get_all_blocks(self) -> list[BlockDefinition]: ...
    def get_block_owner(self, block_type: str) -> Optional[str]: ...
    def get_all_plugins(self) -> list[PluginInfo]: ...
    def unregister_plugin(self, plugin_name: str) -> None: ...

class AssetType:
    Image: AssetType
    Audio: AssetType
    Font: AssetType
    Data: AssetType
    Unknown: AssetType

class AssetInfo:
    id: str
    asset_type: AssetType
    path: str
    loaded: bool
    kind: str
    def __init__(self, id: str, asset_type: AssetType, path: str) -> None: ...

class AssetManager:
    base_path: str
    def __init__(self) -> None: ...
    def set_base_path(self, path: str) -> None: ...
    def scan(self) -> int: ...
    def resolve_path(self, asset_id: str) -> Optional[str]: ...
    def register_asset(self, id: str, asset_type: AssetType, path: str) -> None: ...
    def has_asset(self, id: str) -> bool: ...
    def get_asset(self, id: str) -> Optional[AssetInfo]: ...
    def get_all_assets(self) -> list[AssetInfo]: ...
    def clear(self) -> None: ...
    def asset_count(self) -> int: ...

class FixedTickLoop:
    def __init__(self) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...
    def is_running(self) -> bool: ...
    def tick(self, wait: bool = True) -> bool: ...
    def get_fps(self) -> int: ...
    def set_fps(self, fps: int) -> None: ...
    def fixed_delta(self) -> float: ...
    def get_frame_count(self) -> int: ...
    def reset_counter(self) -> None: ...

# --- compiler (AstNode, AstGraph and CompiledProgram come from GraphCompiler)

class AstNode:
    id: str
    node_type: str
    position: Optional[tuple[int, int]]
    parameters: dict[str, str]
    successors: list[str]
    successor_ports: list[Optional[int]]
    predecessors: list[str]

class AstGraph:
    graph_id: str
    version: str
    nodes: dict[str, AstNode]
    entry_nodes: list[str]
    def get_node(self, id: str) -> Optional[AstNode]: ...
    def get_node_ids(self) -> list[str]: ...
    def is_dag(self) -> bool: ...
    def start_node(self) -> Optional[str]: ...

class ValidationError:
    error_type: str
    message: str
    node_id: Optional[str]
    hint: Optional[str]
    graph_id: Optional[str]
    def __init__(
        self,
        error_type: str,
        message: str,
        node_id: Optional[str] = None,
        hint: Optional[str] = None,
        graph_id: Optional[str] = None,
    ) -> None: ...

class GraphValidator:
    def __init__(
        self, registry: Optional[PluginRegistry] = None, assets: Optional[AssetManager] = None
    ) -> None: ...
    def validate(self, graph: AstGraph) -> list[ValidationError]: ...
    def is_valid(self, graph: AstGraph) -> bool: ...

class CompiledProgram:
    graph_id: str
    node_map: list[str]
    node_types: dict[str, str]
    def opcode_count(self) -> int: ...
    def get_opcodes(self) -> list[str]: ...
    def disassemble(self) -> str: ...
    def fingerprint(self) -> str: ...

class CompiledProject:
    project_id: str
    start: str
    variables: dict[str, Any]
    def scene_ids(self) -> list[str]: ...
    def get_scene(self, scene_id: str) -> Optional[CompiledProgram]: ...
    def fingerprint(self) -> str: ...
    def disassemble(self) -> str: ...

class GraphCompiler:
    registry: PluginRegistry
    def __init__(self, registry: Optional[PluginRegistry] = None) -> None: ...
    def set_assets(self, assets: Optional[AssetManager]) -> None: ...
    def parse(self, json_str: str) -> AstGraph: ...
    def validate(self, graph: AstGraph) -> list[str]: ...
    def compile(self, graph: AstGraph) -> CompiledProgram: ...
    def compile_json(self, json_str: str) -> CompiledProgram: ...
    def compile_project_json(self, json_str: str) -> CompiledProject: ...
    def get_last_errors(self) -> list[str]: ...
    def has_errors(self) -> bool: ...
    def clear_errors(self) -> None: ...

# --- VM -----------------------------------------------------------------

class PyVMState:
    pc: int
    stack: list[str]
    variables: dict[str, str]
    current_node_id: Optional[str]
    is_yielding: bool
    yield_reason: Optional[str]
    is_running: bool
    last_block_type: Optional[str]
    last_block_args: Optional[str]
    current_graph_id: str
    call_depth: int
    waiting_frames: int
    seen_before: bool
    paused_at: Optional[str]
    call_stack: list[str]
    def __init__(self) -> None: ...
    def get_variable(self, name: str) -> Optional[str]: ...
    def stack_depth(self) -> int: ...
    def is_ended(self) -> bool: ...

class VMExecutor:
    def __init__(self) -> None: ...
    def load(self, program: CompiledProgram) -> None: ...
    def load_project(self, project: CompiledProject) -> None: ...
    def tick(self, max_steps: int = ...) -> Optional[PyVMState]: ...
    def set_event_bus(self, event_bus: EventBus) -> None: ...
    def start(self) -> None: ...
    def step(self) -> Optional[PyVMState]: ...
    def resume(self, choice: Any = None) -> Optional[PyVMState]: ...
    def run_until_yield(self, max_steps: int = ...) -> Optional[PyVMState]: ...
    def stop(self) -> None: ...
    def get_state(self) -> PyVMState: ...
    def get_variable(self, name: str) -> Optional[str]: ...
    def set_variable(self, name: str, json_value: str) -> None: ...
    def save_state(self) -> str: ...
    def load_state(self, json_state: str) -> None: ...
    def set_breakpoint(self, scene: str, node_id: str, enabled: bool = True) -> None: ...
    def clear_breakpoints(self) -> None: ...
    def get_breakpoints(self) -> list[str]: ...
    def continue_execution(self) -> None: ...
    def step_node(self) -> None: ...
    def get_persistent_variables(self) -> str: ...
    def rollback(self) -> Optional[PyVMState]: ...
    def set_rollback_limit(self, limit: int) -> None: ...
    def get_backlog(self) -> str: ...
    def get_host_state(self) -> str: ...
    def set_host_state(self, json_value: str) -> None: ...
    def save_persistent(self) -> str: ...
    def load_persistent(self, json_data: str) -> None: ...
    def get_log(self) -> list[str]: ...
    def is_running(self) -> bool: ...
    def is_yielding(self) -> bool: ...
    def reset(self) -> None: ...

# --- plugins ------------------------------------------------------------

class NovelPlugin:
    def __init__(self) -> None: ...
    def get_info(self) -> PluginInfo: ...
    def register_blocks(self, registry: PluginRegistry) -> None: ...
    def get_block_types(self) -> list[str]: ...
