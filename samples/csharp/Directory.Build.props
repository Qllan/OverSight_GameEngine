<Project>
  <!-- Common settings of the C# samples -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../bindings/csharp/ORST/ORST.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)Common.cs" Link="Common.cs" />
    <None Include="$(MSBuildThisFileDirectory)../assets/*.png;$(MSBuildThisFileDirectory)../assets/*.tmj" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
